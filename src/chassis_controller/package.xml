  <version>1.0.0</version>
  <description>This package provides different drives for robots</description>
  <maintainer email="l.mudrich@leeds.ac.uk">Lenka Mudrich</maintainer>
  <maintainer email="a.j.blight@leeds.ac.uk">Andy Blight</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pipebot_msgs</depend>
