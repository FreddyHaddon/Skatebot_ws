<?xml version="1.0"?>
  <robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="add_controller" params="joint">
            <joint name="${joint}">
                <command_interface name="velocity">
                    <param name="min">-10</param>
                    <param name="max">10</param>
                </command_interface>
                <state_interface name="velocity"/>
                <state_interface name="position"/>
            </joint>
  </xacro:macro>
     
  <xacro:macro name="add_gazebo_plugin"> 	
  	<gazebo>
        	<plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            		<parameters>$(find pipebot_4wd)/config/steering_controller_velocity.yaml</parameters>
        	</plugin>
  	</gazebo>
  </xacro:macro>
  
</robot>
